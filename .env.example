# Copy this file to .env and fill in your values.
# docker-compose picks this up automatically.

# API key for the operator REST API and web UI
CAMI_API_KEY=changeme

# Override the control-plane URL used by the Vite proxy (only affects local dev)
# CONTROL_PLANE_URL=http://control-plane:8080

# Base URL for artifact downloads as seen by agents.
# In Docker compose this is set to http://control-plane:8080 automatically.
# For local dev (agents outside Docker) use http://localhost:8080.
# ARTIFACTS_BASE_URL=http://control-plane:8080

# Inference backend: "litert", "ollama", or "stub".
# Empty = auto-detect from LITERT_URL / OLLAMA_URL (priority: litert > ollama > stub).
# RUNTIME_BACKEND=

# LiteRT-LM: URL of `litert-lm serve` (OpenAI-compatible; default port 9379).
# The agent passes it the path of the verified .litertlm file, so the server
# must see MODEL_CACHE_DIR at the same absolute path.
# LITERT_URL=http://litert:9379
# LITERT_ACCELERATOR=cpu            # cpu | gpu | npu
# MODEL_CACHE_DIR=/var/lib/cami/models
# PROBE_INTERVAL_SECS=30

# Ollama server URL
# OLLAMA_URL=http://ollama:11434

# Webhook URL for alerts (device offline, deployment failed)
# Supports Slack incoming webhooks, Discord webhooks, or any HTTP POST endpoint
# WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx

# Grafana admin password
GRAFANA_PASSWORD=changeme
