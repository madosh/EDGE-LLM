# /etc/cami/agent.env — settings for the cami-agent systemd service.

# Must equal the common name on this device's certificate.
DEVICE_NAME=pi-1
DEVICE_LABELS=location=lab,type=rpi5,runtime=litert

# Use a name that appears in the server certificate (see SERVER_SANS in
# docs/edge-device-setup.md), e.g. the control-plane host's LAN IP.
CONTROL_PLANE_URL=https://192.168.1.20:9090
CERT_DIR=/etc/cami/certs

RUNTIME_BACKEND=litert
LITERT_URL=http://127.0.0.1:9379
# cpu works everywhere; try gpu on a Raspberry Pi 5 (experimental).
LITERT_ACCELERATOR=cpu

MODEL_CACHE_DIR=/var/lib/cami/models
PROBE_INTERVAL_SECS=30
RUST_LOG=cami_agent=info,warn
