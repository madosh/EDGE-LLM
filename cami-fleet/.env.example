# Copy this file to .env and fill in your values.
# docker-compose picks this up automatically.

# API key for the operator REST API and web UI
CAMI_API_KEY=changeme

# Override the control-plane URL used by the Vite proxy (only affects local dev)
# CONTROL_PLANE_URL=http://control-plane:8080

# Base URL for artifact downloads as seen by agents.
# In Docker compose this is set to http://control-plane:8080 automatically.
# For local dev (agents outside Docker) use http://localhost:8080.
# ARTIFACTS_BASE_URL=http://control-plane:8080

# Inference backend: "litert", "ollama", or "stub".
# Empty = auto-detect from LITERT_URL / OLLAMA_URL (priority: litert > ollama > stub).
# RUNTIME_BACKEND=

# Google LiteRT server URL (Gemini-compatible API served by `lit serve`)
# LITERT_URL=http://litert:8000
# LITERT_MODEL=gemma3-1b

# Ollama server URL
# OLLAMA_URL=http://ollama:11434
